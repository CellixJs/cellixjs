{
	"extends": "@cellix/config-typescript/node",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
		// openid-client's declarations do not satisfy exactOptionalPropertyTypes.
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts"],
	"references": [{ "path": "../api-services-spec" }, { "path": "../service-blob-storage" }]
}
