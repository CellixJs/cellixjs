{
	"typescript": {
		"command": "pnpm",
		"args": ["exec", "tsgo", "--lsp", "--stdio"],
		"extensionToLanguage": {
			".ts": "typescript",
			".tsx": "typescriptreact",
			".mts": "typescript",
			".cts": "typescript",
			".js": "javascript",
			".jsx": "javascriptreact",
			".mjs": "javascript",
			".cjs": "javascript"
		},
		"startupTimeout": 60000
	}
}
